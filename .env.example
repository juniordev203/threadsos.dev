# ============================================
# AI Growth OS for Threads — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here
# Alternative traditional keys (optional):
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# --- Clerk Auth ---
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
NUXT_CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
